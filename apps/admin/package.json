{
  "name": "@keel/admin",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS admin business application — currently scaffolded for tasks 9.1 (Zustand stores) and 9.3 (BasicLayout shell). Vite, Mock layer, and full route bootstrap land in subsequent task-9.x sub-tasks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:dev": "vite build --mode development",
    "build:analyze": "ANALYZE=true vite build --mode production",
    "preview": "vite preview --port 4173",
    "lint": "echo 'lint @keel/admin: no ESLint yet (will be wired in task 2 polish).'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rimraf .turbo node_modules"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@keel/auth": "workspace:*",
    "@keel/http": "workspace:*",
    "@keel/i18n": "workspace:*",
    "@keel/theme": "workspace:*",
    "@keel/types": "workspace:*",
    "@keel/ui": "workspace:*",
    "@keel/utils": "workspace:*",
    "antd": "^5.29.3",
    "axios": "^1.7.0",
    "dompurify": "^3.1.0",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.30.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@keel/eslint-config": "workspace:*",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.21.0",
    "jsdom": "^24.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-mock": "^3.0.2",
    "vitest": "^2.1.2"
  }
}
