{
  "name": "@keel/utils",
  "version": "0.1.0",
  "description": "Framework-agnostic utilities (storage, logger, eventBus, debounce, stableHash).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo 'lint @keel/utils: no ESLint yet (will be wired in task 2 polish).'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@keel/types": "workspace:*"
  },
  "devDependencies": {
    "@keel/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
