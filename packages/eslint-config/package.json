{
  "name": "@keel/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint / Prettier / TypeScript config for keel-admin workspaces.",
  "type": "commonjs",
  "main": "./index.js",
  "files": [
    "index.js",
    "react.js",
    "node.js",
    "prettier.js",
    "tsconfig.json",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./react": "./react.js",
    "./node": "./node.js",
    "./prettier": "./prettier.js",
    "./tsconfig.json": "./tsconfig.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "eslint": "^8.57.0",
    "prettier": ">=3.0.0",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
