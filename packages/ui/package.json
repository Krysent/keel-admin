{
  "name": "@keel/ui",
  "version": "0.1.0",
  "description": "Business components for keel-admin (ProTable / ProForm / PageContainer / KeelTable thin wrappers). Currently ships only the pure column permission filter (task 8.1); the React surface lands with task 8.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo 'lint @keel/ui: no ESLint yet (will be wired in task 2 polish).'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "@ant-design/pro-components": "^2.0.0",
    "antd": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/pro-components": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@keel/auth": "workspace:*",
    "@keel/i18n": "workspace:*",
    "@keel/theme": "workspace:*",
    "@keel/types": "workspace:*"
  },
  "devDependencies": {
    "@keel/eslint-config": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.21.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
