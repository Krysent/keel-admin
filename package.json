{
  "name": "keel-admin",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS admin template (saas-admin-template) — pnpm workspaces + Turborepo monorepo.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "ci:verify": "node tooling/scripts/verify-turbo-cache.mjs",
    "ci:check-cycles": "node tooling/scripts/check-package-cycles.mjs",
    "ci:validate-mocks": "node tooling/scripts/validate-mock-schema.mjs",
    "check-chunk-size": "node tooling/scripts/check-chunk-size.mjs",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@keel/eslint-config": "workspace:^",
    "@types/node": "^20.16.10",
    "eslint": "^8.57.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
